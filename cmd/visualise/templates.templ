package main

import "evis/internal/ber"

templ Page(v View) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>ETSI TS 102 232 — DNS handover PDU visualiser</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<header>
				<h1>ETSI TS 102 232 · handover PDU visualiser</h1>
				<span class="sub">HI2/HI3 PS-PDU → payload → IPCC / IPIRIOnly / IPMMCC / IPMMIRI → IPv4 · UDP/TCP · DNS/HTTP/SIP/RTP</span>
			</header>
			<main
				class="wrap"
				data-signals={ "{o: -1, l: 0, so: -1, sl: 0, sid: -1, sn: '', follow: true, sample: '" + v.ActiveSample + "'}" }
				data-on-keydown__window={ "evt.key === 'Escape' && (" + clearSelExpr + ")" }
			>
				<div class="controls">
					<div class="group">
						<label>DNS:</label>
						<button data-on-click={ sampleExpr("cc") } data-class={ sampleClassExpr("cc") }>CC payload</button>
						<button data-on-click={ sampleExpr("iri") } data-class={ sampleClassExpr("iri") }>IRI-only</button>
						<button data-on-click={ sampleExpr("both") } data-class={ sampleClassExpr("both") }>IRI + CC</button>
					</div>
					<div class="group">
						<label>HTTP:</label>
						<button data-on-click={ sampleExpr("http-cc") } data-class={ sampleClassExpr("http-cc") }>CC payload</button>
						<button data-on-click={ sampleExpr("http-iri") } data-class={ sampleClassExpr("http-iri") }>IRI-only</button>
						<button data-on-click={ sampleExpr("http-both") } data-class={ sampleClassExpr("http-both") }>IRI + CC</button>
						<button data-on-click={ sampleExpr("http-exchange") } data-class={ sampleClassExpr("http-exchange") }>Exchange</button>
						<button data-on-click={ sampleExpr("http-reordered") } data-class={ sampleClassExpr("http-reordered") }>Reordered</button>
					</div>
					<div class="group">
						<label>VoIP:</label>
						<button data-on-click={ sampleExpr("voip-cc") } data-class={ sampleClassExpr("voip-cc") }>RTP CC</button>
						<button data-on-click={ sampleExpr("voip-iri") } data-class={ sampleClassExpr("voip-iri") }>SIP IRI</button>
						<button data-on-click={ sampleExpr("voip-both") } data-class={ sampleClassExpr("voip-both") }>IRI + CC</button>
					</div>
					<div class="group">
						<form data-on-submit__prevent="sse('/upload', {method: 'post', contentType: 'form'})">
							<label class="filelbl">
								Upload .etsi…
								<input type="file" name="file" accept=".etsi,.bin,.ps,.hi3,application/octet-stream" data-on-change={ "sample.value = ''; " + clearSelExpr + "; sse('/upload', {method: 'post', contentType: 'form'})" }/>
							</label>
						</form>
					</div>
				</div>
				<div class="selbar">
					<span class="sellbl">Selected:</span>
					<span class="selname" data-show="sid.value >= 0" data-text="sn.value"></span>
					<span class="selnone" data-show="sid.value < 0">nothing — click a field in the PDU tree to pin it</span>
					<span class="selbtns">
						<button data-on-click="evisReveal(so.value)" data-attributes-disabled="sid.value < 0">Jump to selection</button>
						<button data-on-click={ clearSelExpr } data-attributes-disabled="sid.value < 0">Clear selection</button>
						<button data-on-click="follow.value = !follow.value" data-class="{active: follow.value}" title="When on, selecting a field scrolls the raw BER pane to its bytes">Auto-scroll</button>
					</span>
				</div>
				@Result(v)
			</main>
			<script src="/static/app.js"></script>
			<script type="module" src="/static/datastar.js"></script>
		</body>
	</html>
}

templ Result(v View) {
	<div id="result">
		<div class="summary">
			<span class="src">{ v.Source }</span>
			<span class="desc">{ v.Summary }</span>
			<span class="len">{ offLabelLen(v) }</span>
		</div>
		if v.Err != "" {
			<div class="summary"><span class="err">decode error: { v.Err }</span></div>
		}
		<div class="panes">
			<div class="pane">
				<div class="cap">Raw BER ({ byteLen(v) } bytes) — scroll independently; the pinned selection stays highlighted</div>
				<div class="body" id="hexbody">
					<div class="hex" data-on-mouseleave="o.value=-1; l.value=0">
						for row := 0; row < numRows(len(v.Bytes)); row++ {
							@hexRow(v.Bytes, row)
						}
					</div>
				</div>
			</div>
			<div class="pane">
				<div class="cap">PDU tree — hover to preview, click to pin; ▸ expands</div>
				<div class="body">
					<div class="tree" data-on-mouseleave="o.value=-1; l.value=0">
						for _, n := range v.Nodes {
							@node(v, n)
						}
					</div>
					<div class="legend">
						<code>[n]</code> context tag · <code>EXPLICIT</code> wraps a CHOICE · dashed tags are decoded inner protocol fields, not ASN.1.
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ hexRow(b []byte, row int) {
	<div class="hrow">
		<span class="off">{ offLabel(row) }</span>
		<span class="hbytes">
			for _, i := range rowBytes(b, row) {
				<span
					class={ "byte", templ.KV("gap", i%16 == 8) }
					data-class={ byteClassExpr(i) }
				>{ hexByte(b[i]) }</span>
			}
		</span>
		<span class="hasc">{ asciiRow(b, row) }</span>
	</div>
}

templ node(v View, n *ber.Node) {
	if hasKids(n) {
		<details open>
			<summary
				title={ n.Note }
				data-on-mouseenter={ hoverExpr(n.Offset, n.TotalLen()) }
				data-on-click={ selectExpr(v, n) }
				data-class={ rowClassExpr(v, n) }
			>
				<span class="caret" title="expand / collapse"></span>
				@badges(n)
			</summary>
			<div class="node-children">
				for _, c := range n.Children {
					@node(v, c)
				}
			</div>
		</details>
	} else {
		<div
			class="leaf"
			title={ n.Note }
			data-on-mouseenter={ hoverExpr(n.Offset, n.TotalLen()) }
			data-on-click={ selectExpr(v, n) }
			data-class={ rowClassExpr(v, n) }
		>
			@badges(n)
		</div>
	}
}

templ badges(n *ber.Node) {
	if n.TagString() != "" {
		<span class="tag">{ n.TagString() }</span>
	} else if n.Raw {
		<span class="tag raw">raw</span>
	}
	<span class="nm">{ n.Name }</span>
	if n.TypeName != "" {
		<span class="ty">{ n.TypeName }</span>
	}
	if n.Value != "" {
		<span class="vl">{ n.Value }</span>
	}
	<span class="off2">{ offInfo(n) }</span>
}
